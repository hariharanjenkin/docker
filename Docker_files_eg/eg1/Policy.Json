{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowFullS3Access",
        "Effect": "Allow",
        "Action": "s3:*",
        "Resource": "*"
      },
      {
        "Sid": "DenyDeleteOperations",
        "Effect": "Deny",
        "Action": [
          "s3:DeleteObject",
          "s3:DeleteObjectVersion",
          "s3:DeleteBucket",
          "s3:DeleteBucketPolicy",
          "s3:DeleteBucketWebsite",
          "s3:DeleteBucketOwnershipControls",
          "s3:DeleteStorageLensConfiguration"
        ],
        "Resource": "*"
      }
    ]
  }